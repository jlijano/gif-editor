<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Sprite GIF Converter / Editor</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<main class="wrap">
    <header class="hero">
        <div>
            <h1>Sprite GIF Converter / Editor</h1>
            <p>Upload separate frames or a sprite strip, preview the cleaned frames, then combine them into one animated GIF.</p>
        </div>
    </header>

    <% if (error) { %>
        <section class="alert error">
            <strong>Error:</strong> <%= error %>
        </section>
    <% } %>

    <% if (result) { %>
        <section class="card success-card">
            <h2>Converted GIF</h2>
            <div class="preview-box">
                <img src="<%= result.output_url %>?t=<%= Date.now() %>" alt="Generated GIF preview">
            </div>
            <p class="muted"><%= result.message %></p>
            <a class="button" href="<%= result.output_url %>" download>Download GIF</a>
        </section>
    <% } %>

    <section class="card">
        <h2>Upload and Convert</h2>

        <form method="post" enctype="multipart/form-data" class="form">
            <div class="frames-grid" id="framesContainer">
                <label class="field upload-field">
                    <span>Frame 1</span>
                    <input type="file" name="frames" class="frame-input" accept=".png,.jpg,.jpeg,.webp,.gif,image/png,image/jpeg,image/webp,image/gif" required>
                    <div class="frame-preview-card" id="framePreview1">
                        <div class="preview-placeholder-small">No image selected</div>
                    </div>
                </label>

                <label class="field upload-field">
                    <span>Frame 2</span>
                    <input type="file" name="frames" class="frame-input" accept=".png,.jpg,.jpeg,.webp,.gif,image/png,image/jpeg,image/webp,image/gif" required>
                    <div class="frame-preview-card" id="framePreview2">
                        <div class="preview-placeholder-small">No image selected</div>
                    </div>
                </label>
            </div>

            <div class="frame-actions">
                <button type="button" class="button" id="addFrameButton">+ Add frame</button>
                <button type="button" class="button splice-button is-hidden" id="spliceFrameButton">Splice image</button>
                <button type="button" class="button" id="manualSpliceToggle">Manual crop</button>
            </div>

            <div class="splice-notice is-hidden" id="spliceNotice" role="status"></div>

            <section class="manual-splice-panel is-hidden" id="manualSplicePanel">
                <h3>Manual crop</h3>
                <div class="manual-crop-layout">
                    <div class="manual-crop-stage" id="manualCropStage">
                        <canvas id="manualCropCanvas" width="640" height="360"></canvas>
                    </div>
                </div>

                <div class="grid manual-splice-grid">
                    <label class="field">
                        <span>Source frame</span>
                        <select id="manualSourceFrame"></select>
                    </label>

                    <label class="field">
                        <span>Frames <strong id="manualFrameCountValue">4</strong></span>
                        <input type="range" id="manualFrameCount" min="2" max="12" value="4">
                    </label>

                    <label class="field">
                        <span>Direction</span>
                        <select id="manualDirection">
                            <option value="horizontal">Horizontal</option>
                            <option value="vertical">Vertical</option>
                        </select>
                    </label>
                </div>
                <div class="manual-crop-meta" id="manualCropInfo">No image selected</div>
                <button type="button" class="button" id="manualCropResetButton">Reset crop</button>
                <button type="button" class="button splice-button" id="manualSpliceButton">Apply manual crop</button>
                <div class="manual-splice-message is-hidden" id="manualSpliceMessage" role="status"></div>
            </section>

            <label class="field drop-zone" id="dropZone">
                <span>Quick upload</span>
                <p class="drop-zone-hint">Drag & drop 2 or more images here or paste them from the clipboard.</p>
            </label>

            <section class="preview-section">
                <h2>Selected frames preview</h2>
                <div class="preview-grid" id="previewGrid">
                    <div class="preview-placeholder">Select images to preview removed background here.</div>
                </div>
            </section>

            <div class="suggestion-row">
                <div>Suggested width: <strong id="suggestedWidth">32</strong></div>
                <div>Suggested height: <strong id="suggestedHeight">32</strong></div>
                <div>Max width: <strong id="maxWidth">32</strong></div>
                <div>Max height: <strong id="maxHeight">32</strong></div>
            </div>

            <div class="grid">
                <label class="field">
                    <span>Frame width</span>
                    <input type="number" name="frame_width" min="1" value="32">
                </label>

                <label class="field">
                    <span>Frame height</span>
                    <input type="number" name="frame_height" min="1" value="32">
                </label>

                <label class="field">
                    <span>Frame rate</span>
                    <input type="number" name="frame_rate" min="1" max="60" value="24">
                </label>

                <label class="field">
                    <span>Loop count</span>
                    <select name="loop">
                        <option value="0">Forever</option>
                        <option value="1">Once</option>
                    </select>
                </label>
            </div>

            <button class="button primary" type="submit">Create animated GIF</button>
        </form>
    </section>

    <% if (recent && recent.length) { %>
        <section class="card">
            <h2>Recent Outputs</h2>
            <div class="recent">
                <% recent.forEach((item) => { %>
                    <a class="recent-item" href="<%= item.url %>" download>
                        <img src="<%= item.url %>?t=<%= item.mtime %>" alt="">
                        <span><%= item.name %></span>
                    </a>
                <% }) %>
            </div>
        </section>
    <% } %>
</main>

<script src="/assets/app.js"></script>
</body>
</html>
